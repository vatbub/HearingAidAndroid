<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context="com.github.vatbub.hearingaid.fragments.StreamingFragment">

    <!-- Scrollable Dashboard Content -->
    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ATLAS Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:id="@+id/custom_drawer_toggle"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/atlas_circle_active">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_menu_slideshow"
                        android:tint="@color/text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:text="ATLAS"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/atlas_circle_active" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Connected"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Noise Level Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/atlas_bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOISE LEVEL"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/noise_level_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="42"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp"
                            android:text="dB"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe Level"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Visualization Bars (Mock) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="12dp"
                        android:layout_margin="2dp"
                        android:background="@color/colorAccent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:layout_margin="2dp"
                        android:background="@color/colorAccent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:layout_margin="2dp"
                        android:background="@color/colorAccent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:layout_margin="2dp"
                        android:background="@color/colorAccent" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_margin="2dp"
                        android:background="@color/surface_border" />
                </LinearLayout>
            </LinearLayout>

            <!-- Profile Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="CURRENT ENVIRONMENT"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/dashboard_profile_selector"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/atlas_bg_card" />

            </LinearLayout>

            <!-- Big Mic Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="32dp">

                <ImageButton
                    android:id="@+id/mainToggleButton"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/atlas_circle_active"
                    android:elevation="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_menu_share"
                    android:tint="@color/text_primary" />
                    <!-- Using generic icon for now, will fix -->

                <TextView
                    android:id="@+id/streaming_status_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Listening..."
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Noise cancellation active"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Volume Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/atlas_bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VOLUME BOOST"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/volume_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/volume_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="85"
                    android:progressTint="@color/colorPrimary"
                    android:thumbTint="@color/colorPrimary" />
            </LinearLayout>

        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

    <!-- KEEPING BOTTOM SHEETS TO PREVENT CRASHES -->
    <!-- Connect Headphones -->
    <android.support.v4.widget.NestedScrollView
        android:id="@+id/connect_headphones_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:behavior_hideable="true"
        app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
        <!-- Content preserved abstractly -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView android:text="Connect Headphones" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/wired_headphones_play_anyway_button" android:text="Play anyway" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/wired_headphones_dont_show_again_button" android:text="Don't show again" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

    <!-- Low Latency -->
    <android.support.v4.widget.NestedScrollView
        android:id="@+id/low_latency_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:behavior_hideable="true"
        app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/tv_low_latency" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/learn_more_button" android:text="Learn More" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/low_latency_dont_show_again_button" android:text="Dismiss" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

    <!-- MOTD -->
    <android.support.v4.widget.NestedScrollView
        android:id="@+id/motd_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:behavior_hideable="true"
        app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <WebView android:id="@+id/motd_web_view" android:layout_width="match_parent" android:layout_height="200dp"/>
            <Button android:id="@+id/motd_read_more" android:text="Read More" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/motd_close" android:text="Close" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

    <!-- Diagnostic Data -->
    <android.support.v4.widget.NestedScrollView
        android:id="@+id/diagnostic_data_bottom_Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:behavior_hideable="true"
        app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:text="Enable Diagnostics?" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/diagnostic_data_yes_button" android:text="Yes" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/diagnostic_data_no_button" android:text="No" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/diagnostic_data_privacy_policy_button" android:text="Privacy Policy" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </android.support.v4.widget.NestedScrollView>

</android.support.design.widget.CoordinatorLayout>
